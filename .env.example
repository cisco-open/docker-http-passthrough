# OpenTelemetry Configuration
# Leave empty or remove to disable OTEL export

# OTLP endpoint for the collector (e.g., http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: Override the default service name (default: docker-http-passthrough)
OTEL_SERVICE_NAME=

# Optional: Override the registry endpoints and display name
# REGISTRY_URL=https://registry-1.docker.io
# REGISTRY_AUTH_URL=https://auth.docker.io/token
# REGISTRY_SERVICE=registry.docker.io
# REGISTRY_NAME=docker.io

# Optional: Authenticate to private registries
# Static credentials apply to the passthrough service instance. Leave these
# unset when Cisco clients should supply registry credentials per request with
# /registry-auth/{scheme}/{host}/docker/{filename}.
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
# REGISTRY_BEARER_TOKEN=
# Compatibility alias for REGISTRY_BEARER_TOKEN
# REGISTRY_TOKEN=

# Optional: Use HTTP Basic credentials supplied by the downloading client.
# optional = accept a Basic Authorization header if the client sends one
# required = challenge the client and require Basic credentials per request
# off = ignore client-supplied credentials
# REGISTRY_CLIENT_AUTH=optional

# Common modes:
# - Static default registry:
#   REGISTRY_URL=https://registry.example.com
#   REGISTRY_NAME=registry.example.com
#   REGISTRY_USERNAME=<registry-user>
#   REGISTRY_PASSWORD=<registry-token>
# - Neutral Cisco-selected registry and credentials:
#   leave REGISTRY_USERNAME, REGISTRY_PASSWORD, and REGISTRY_BEARER_TOKEN unset
#   use /registry-auth/{scheme}/{host}/docker/{filename}
# - Private GHCR:
#   use /registry-auth/https/ghcr.io/docker/<owner>__<package>_<tag>.tar
#   configure Cisco ip http client username/password with a package-readable token

# Optional: Default namespace for single-component image names.
# Unset defaults to "library" for Docker Hub and no namespace for other registries.
# Set to an empty value to disable Docker Hub's library/ default.
# REGISTRY_DEFAULT_NAMESPACE=
